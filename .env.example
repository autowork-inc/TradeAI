# Скопируйте в .env и заполните. Файл .env не коммитьте.
# Ключи читаются ТОЛЬКО из окружения процесса; в логи и файлы состояния не пишутся.

# --- Профиль сети: mainnet | testnet ---------------------------------------
# testnet -> REST https://testnet.binancefuture.com, WS wss://stream.binancefuture.com
BINANCE_PROFILE=testnet

# Ключи ТЕСТОВОЙ сети: https://testnet.binancefuture.com (вход через GitHub -> API Key).
# Ключи основной сети сюда не вставляйте.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Необязательные переопределения адресов (сильнее профиля) ----------------
# Раскладка маршрутов /public и /private на тестовой сети живьём не проверена:
# при отказе рукопожатия поправьте здесь.
# BINANCE_REST_URL=https://testnet.binancefuture.com
# BINANCE_WS_URL=wss://stream.binancefuture.com/public/stream
# BINANCE_WS_PRIVATE_URL=wss://stream.binancefuture.com/private

# --- Telegram-алерты (необязательно) ----------------------------------------
# Не заданы -> события пишутся только в консоль/лог.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Каталоги (для Docker уже заданы в образе) -------------------------------
# TRADING_DATA_DIR=./data
# TRADING_LOG_DIR=./logs
