# Секреты Shadow Mode (Этап 5-6). Копировать в .env.shadow НЕ нужно вручную: deploy/shadow.sh создаёт файл сам
# (случайные значения, chmod 600). Файл .env.shadow не коммитьте и не кладите в архив.
#
# Пароль БД: только латиница и цифры (подставляется в postgresql://tradeai:<пароль>@postgres:5432/tradeai без экранирования).
POSTGRES_PASSWORD=
# Ключ API мониторинга (Этап 6): клиент шлёт его в заголовке X-API-Key. Не короче 32 символов, без пробелов.
# Показать на сервере: ./deploy/shadow.sh apikey
API_KEY=
# Необязательно. По умолчанию API опубликован на 0.0.0.0:8001 (клиент ходит напрямую по IP сервера; порт 8000 на сервере занят).
# Только с самого сервера (SSH-туннель):  API_BIND=127.0.0.1.  Другой внешний порт:  API_PORT=...
# API_BIND=0.0.0.0
# API_PORT=8001
# Данные Forex/металлов для Shadow (EURUSD, XAUUSD, XAGUSD) из MetaApi. Впишите на сервере ВРУЧНУЮ (скрипты и архив эти значения не передают);
# лучше токен только на чтение рыночных данных. Пусто - MT5-символы в Shadow пропускаются, работает крипта.
# METAAPI_TOKEN=
# METAAPI_ACCOUNT_ID=
# MT5_SYMBOL_MAP=XAUUSD=GOLD
# БОЕВОЙ режим (./deploy/shadow.sh up-live; сервис shadow-live в docker-compose.yml). Только вручную на сервере; без LIVE_ALLOW_MAINNET=true (или USE_TESTNET=true) не стартует.
# Размер фиксирован (маржа x плечо), не более 4 одновременных позиций, остальные сигналы остаются виртуальными.
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# LIVE_ALLOW_MAINNET=true
# USE_TESTNET=true
# APPROVED_STRATEGIES=SMC_Pro_Trend,VWAP_Reversion
# LIVE_MARGIN_USDT=10
# LIVE_LEVERAGE=10
# LIVE_DAILY_LOSS_LIMIT_USDT=50
# LIVE_MAX_OPEN_POSITIONS=4
# Автоприменение обновлений (deploy/apply.sh, вызывается CI / scripts/auto_deploy.py / cron): контур определяется по запущенному контейнеру;
# если ничего не запущено - DEPLOY_CONTOUR=live|shadow (по умолчанию shadow). Обновление боевого контура откладывается, пока есть открытые позиции или ждущие заявки,
# но не дольше APPLY_MAX_DEFER_H часов (по умолчанию 12; 0 = ждать бесконечно).
# DEPLOY_CONTOUR=live
# APPLY_MAX_DEFER_H=12
# Автоселектор монет по суточному объёму (раз в 6 ч): >= 400M USDT -> live-уровень (BTC и ETH закреплены), 100M..400M -> только Shadow (Binance Test), ниже - не отслеживаются.
# Включён по умолчанию; UNIVERSE_AUTO=false оставляет только закреплённые BTC/ETH и MT5-символы.
# UNIVERSE_AUTO=true
