# Скопируйте в mcp_server/.env и подставьте пароль. Файл .env не коммитьте и никому не передавайте.
#
# Адрес - ЛОКАЛЬНЫЙ конец SSH-туннеля (mcp_server/tunnel.ps1 пробрасывает 127.0.0.1:15432 -> PostgreSQL на VPS).
# Пароль - POSTGRES_PASSWORD из ~/trading/.env.shadow на сервере (только латиница и цифры, тогда экранировать не нужно;
# спецсимволы в пароле кодируются как %XX).
# Из .env читается ТОЛЬКО строка DATABASE_URL; ключи Binance из корневого .env сервер не трогает.
DATABASE_URL=postgresql://tradeai:ПАРОЛЬ@127.0.0.1:15432/tradeai
